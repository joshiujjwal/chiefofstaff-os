# Server
PORT=3001
NODE_ENV=development

# Database — PostgreSQL connection strings
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://chiefofstaff:devpassword@localhost:5432/chiefofstaff_dev
DATABASE_URL_TEST=postgresql://chiefofstaff:devpassword@localhost:5432/chiefofstaff_test

# Auth — JWT signing secret (generate with: openssl rand -hex 32)
# MUST be at least 32 characters. Never commit the real value.
AUTH_SECRET=replace-me-with-a-real-secret-minimum-32-chars

# Client (optional, defaults shown)
VITE_API_BASE_URL=http://localhost:3001
